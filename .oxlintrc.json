{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "env": {
        "browser": true,
        "node": true,
        "es2015": true
    },
    "categories": {
        "correctness": "error"
    },
    "ignorePatterns": ["**/__tests__/**", "**/dist/**", "**/lib/**", "**/es/**"],
    "rules": {
        "curly": "error",
        "no-var": "error",
        "no-unused-vars": "off",
        "typescript/no-wrapper-object-types": "off",
        "typescript/no-this-alias": "off",
        "unicorn/no-new-array": "off"
    }
}
